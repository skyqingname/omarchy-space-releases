    "locale_categories": [
      "LANG",
      "LC_CTYPE",
      "LC_NUMERIC",
      "LC_TIME",
      "LC_COLLATE",
      "LC_MONETARY",
      "LC_MESSAGES",
      "LC_PAPER",
      "LC_NAME",
      "LC_ADDRESS",
      "LC_TELEPHONE",
      "LC_MEASUREMENT",
      "LC_IDENTIFICATION"
    ],
    "locale_gen_path": "/etc/locale.gen",
    "locale_conf_path": "/etc/locale.conf",
    "user_locale_path": ".config/environment.d/60-omarchy-space-locale.conf",
    "boot_id_path": "/proc/sys/kernel/random/boot_id",
    "timezone_adapters": {
      "aarch64": {
        "set_command": [
          "/usr/bin/try-omarchy-timezone",
          "--select",
          "{timezone}"
        ],
        "mode_command": [
          "/usr/bin/try-omarchy-timezone",
          "--mode"
        ],
        "state_files": [
          "/var/lib/try-omarchy/timezone.json"
        ]
      },
      "x86_64": {
        "set_command": [
          "/usr/bin/timedatectl",
          "set-timezone",
          "{timezone}"
        ],
        "mode_command": null,
        "state_files": []
      }
    },
    "browser": {
      "process_name": "chromium",
      "flags_path": "/etc/chromium-flags.conf",
      "config_directory": ".config/chromium",
      "preferences_glob": "*/Preferences",
      "initial_profile": "Default",
      "shutdown_timeout_seconds": 20,
      "poll_seconds": 0.5
    }
  },
  "shortcuts": {
    "note": {
      "macos-aarch64": "先点一下 Omarchy 窗口，让键盘进入虚拟机，再按下面的组合键。鼠标被窗口抓住时，按 ⌃ ⌥ G 还给 Mac。",
      "windows-x86_64": "先点一下 Omarchy 窗口，让键盘进入虚拟机，再按下面的组合键。"
    },
    "keys": {
      "macos-aarch64": {
