{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoToCS",
  "version": "../package.json",
  "identifier": "dev.omarchy.space",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1428",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title":"GoToCS","width":1140,"height":800,"minWidth":960,"minHeight":720}],
    "security": {"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {"resources/README.md": "README.md"},
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {"minimumSystemVersion": "15.0"}
  }
}
